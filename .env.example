# ─────────────────────────────────────────────────────────────
# Banco de dados (MySQL)
# Opção 1: uma única URL de conexão (tem precedência se definida).
#   Aceita tanto DATABASE_URL quanto MYSQL_URL.
#   Ex.: mysql://usuario:senha@host:3306/nome_do_banco
# DATABASE_URL=mysql://usuario:senha@host:3306/observatorio_manaus
#
# Opção 2: variáveis separadas (usadas se nenhuma URL acima for definida).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=observatorio
MYSQL_PASSWORD=observatorio123
MYSQL_DATABASE=observatorio_manaus

# ─────────────────────────────────────────────────────────────
# LLMs
# Groq: transcrição de vídeos (Whisper) + classificador is_local
GROQ_API_KEY=sua_chave_groq
# OpenAI: geração dos resumos diários (gpt-4o-mini)
OPENAI_API_KEY=sua_chave_openai

# ─────────────────────────────────────────────────────────────
# Email / Digest — Escolha UMA opção:

## Opção A: Sendgrid (Recomendado para Railway — nunca bloqueado)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=seu@email.com
SENDGRID_FROM_NAME=Observatório de Manaus

## Opção B: Brevo (via API REST)
BREVO_API_KEY=sua_chave_api_brevo
BREVO_SENDER_EMAIL=seu@email.com
BREVO_SENDER_NAME=Observatório de Manaus

# ─────────────────────────────────────────────────────────────
# Aplicação
# URL pública do dashboard (usada nos links do boletim e no descadastro)
APP_URL=https://www.observatorio.manaus.br
# Senha do painel admin no dashboard
ADMIN_PASSWORD=obs@manaus

# ─────────────────────────────────────────────────────────────
# YouTube (opcional)
# Cookies do YouTube em base64, para contornar bloqueios de transcrição (429).
# Exporte os cookies de youtube.com, comprima e codifique em base64.
# YOUTUBE_COOKIES_B64=

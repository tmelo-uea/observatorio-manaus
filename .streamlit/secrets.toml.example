# Renomeie para secrets.toml para uso local
# No Streamlit Cloud, configure estas variáveis em Settings > Secrets

# Banco de dados
MYSQL_HOST = "seu-host-mysql-na-nuvem"
MYSQL_PORT = "3306"
MYSQL_USER = "observatorio"
MYSQL_PASSWORD = "sua-senha"
MYSQL_DATABASE = "observatorio_manaus"

# Groq API (para NLP / IA)
GROQ_API_KEY = "sua-chave-groq"

# Brevo (para envio de emails - digest)
BREVO_API_KEY = "sua-chave-api-brevo"
BREVO_SMTP_LOGIN = "seu@email.com"
BREVO_SENDER_EMAIL = "seu@email.com"
BREVO_SENDER_NAME = "Observatório de Manaus"

# Admin
ADMIN_PASSWORD = "sua-senha-admin"
